# Copy to .env and fill in. NEVER commit .env.
VISIONAID_ENV=development
VISIONAID_DATABASE_URL=postgresql+psycopg://visionaid:visionaid@localhost:5432/visionaid

# Required. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
VISIONAID_JWT_SECRET=

# Evidence encryption (AES-256-GCM). Leave empty to refuse all evidence uploads.
# Generate: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
VISIONAID_EVIDENCE_KEY=
VISIONAID_EVIDENCE_DIR=./var/evidence
VISIONAID_EVIDENCE_RETENTION_DAYS=30

# Ephemeral buffer (pushed to devices)
VISIONAID_BUFFER_SECONDS=60
VISIONAID_PRE_EVENT_SECONDS=30
VISIONAID_POST_EVENT_SECONDS=15
VISIONAID_DEVICE_HEARTBEAT_SECONDS=30

# Alerting
VISIONAID_ESCALATION_POLICY=0:primary,30:secondary,60:supervisor,120:emergency
VISIONAID_NOTIFICATION_CHANNELS=["in_app"]
VISIONAID_CORS_ORIGINS=[]

# Used by docker compose for the local database container only
POSTGRES_PASSWORD=
